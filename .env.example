TYPESAFE_API_KEY=your-key-here
# Optional
# PORT=3000
# JEV_MODEL=jev-latest
# JEV_MOCK=1   # force mock answers even with a key
# Decision log (the public chronicle at /eval) and the per-IP limit. With Postgres every instance
# shares one ledger; without it, records go to a local JSONL file.
# DATABASE_URL=postgres://dethrone:dethrone@localhost:5432/dethrone
# LOG_DIR=data/log        # local JSONL file when Postgres is off; set empty to disable
# Optional locally. Signs the reign state the client carries; without it a key is made up at start
# and reigns in progress end when the server restarts. Required on Cloud Run (Terraform sets it).
# STATE_SECRET=
